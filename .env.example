# ==============================================================================
# Vehicle Damage Detection System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# All settings have sensible local defaults; none are mandatory to run locally.

# Server network binding
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Cross-Origin Resource Sharing (comma-separated URLs or JSON array)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Machine Learning model and inference thresholds
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Output visualization storage & pruning policy
OUTPUT_DIR=outputs
OUTPUT_RETENTION_HOURS=24
MAX_OUTPUT_FILES=500
